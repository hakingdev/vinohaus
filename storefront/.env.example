# Saleor GraphQL endpoint — Saleor Cloud dev instance (cloud.saleor.io)
# or local docker (saleor-platform): http://localhost:8000/graphql/
NEXT_PUBLIC_SALEOR_API_URL=https://<instance>.saleor.cloud/graphql/

# Channel slug — prices and availability live per channel
NEXT_PUBLIC_SALEOR_CHANNEL=default-channel

# --- server-only ---

# App token for privileged mutations (Saleor Dashboard → Apps → create local app)
SALEOR_APP_TOKEN=

# Shared secret for webhook endpoints (/api/revalidate, /api/webhooks/*)
SALEOR_WEBHOOK_SECRET=
